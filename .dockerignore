# Host-side venvs (would shadow image-built ones and break symlinks)
.venv
**/.venv

# Node / web build cache
node_modules
**/node_modules
web-ui/dist
web-ui/.vite

# Python caches
__pycache__
**/__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache

# Local artifacts / sessions
.minder
**/.minder
.artifacts
**/.artifacts

# Git
.git
.gitignore

# Editor / OS
.vscode
.idea
.DS_Store

# Test / dist outputs
htmlcov
coverage.xml
.coverage
dist
build
*.egg-info

# Not needed in the runtime image (COPY . . would otherwise ship them).
# The host UI the app serves is prebuilt into minder/web/static (kept); the
# web-ui/ source, tests, docs and local scratch are all build-time-only.
# (Keep *.md — pyproject's readme=README.md is read during the project install.)
tests
docs
web-ui
_local
Tasks

# Module frontend builds — the core image never serves module UIs (each module
# ships its own container); the build only needs modules/*/requirements.txt.
**/frontend/dist
**/frontend/.mf
**/frontend/@mf-types
modules/*/landing

# Misc
*.log
