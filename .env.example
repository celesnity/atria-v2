# LLM provider key (any one)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=
# FIREWORKS_API_KEY=

# Minder runtime
# MINDER_API_BASE_URL=https://your-llm-proxy.example.com/v1/chat/completions
MINDER_MODEL=gpt-5.5
# Used automatically if a call with MINDER_MODEL fails (rate limit, unavailable, etc.)
MINDER_FALLBACK_MODEL=gpt-5.4

# Optional: relocate the app-data home (sessions, cache, workspaces, modules,
# snapshots, etc.). Defaults to ~/.minder under the user home if unset.
# MINDER_DIR=D:\minder-home

# Speech-to-text (voice input). OpenAI-compatible /v1/audio/transcriptions
# backend. For the local uv backend, point at the published `asr` sidecar port;
# docker-compose overrides this to the internal service URL (http://asr:9000/v1)
# automatically. Swap to a managed/GPU endpoint here with no code change.
MINDER_ASR_BASE_URL=http://localhost:9000/v1
MINDER_ASR_MODEL=nvidia/nemotron-3.5-asr-streaming-0.6b
# MINDER_ASR_API_KEY=            # only needed for a managed/remote ASR endpoint

# Postgres (matches db service defaults)
DATABASE_URL=postgresql://minder:minder@db:5432/minder

# Map module (tasco_jarvis_map) GeoRAG backend — dedicated PostGIS+pgvector
# container `map-db` (localhost:5433 for the local uv backend; compose uses
# map-db:5432 internally). MINDER_MAP_BACKEND=db|json (db auto-falls back to
# the JSON engine when the DB is unreachable).
MAP_DATABASE_URL=postgresql://minder_map:minder_map@localhost:5433/minder_map
MINDER_MAP_BACKEND=db

# Zalo Official Account — post-booking owner notification (logistics module).
# Unset -> notify.py runs in dry-run (sends nothing). Setup: docs/zalo-setup.md.
# ZALO_APP_ID=
# ZALO_APP_SECRET=
# ZALO_OWNER_USER_ID=        # owner's user_id as seen by the OA (find via notify.py recent-chats)
# ZALO_OA_ACCESS_TOKEN=      # optional seed; token store .zalo_token.json takes precedence

# maintenance_copilot — LLM endpoint override for no-GPU hosts (else uses local vLLM).
# MC_SYNTHESIS_BASE_URL=https://proxy.onebot.meobeo.ai/v1
# MC_KG_EXTRACT_BASE_URL=https://proxy.onebot.meobeo.ai/v1
