{
  "realm": "minder",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "verifyEmail": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "platform:admin", "description": "Platform super-admin" },
      { "name": "module-register", "description": "May self-register a service-module connector" },
      { "name": "module-push", "description": "May reverse-push blocks/artifacts into a conversation" }
    ]
  },
  "groups": [
    { "name": "tenants" }
  ],
  "clients": [
    {
      "clientId": "minder-web",
      "name": "Minder Web SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*",
        "http://0.0.0.0:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://127.0.0.1:8080",
        "http://0.0.0.0:8080"
      ],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "groups",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "minder-backend",
      "name": "Minder Backend Service",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "secret": "O5Fc8ZjN8uMeDC7l-fz0eocWplZZStrjzTjU6TRaMlA",
      "attributes": {}
    },
    {
      "clientId": "minder-module",
      "name": "Minder Service Module",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "secret": "${MINDER_MODULE_CLIENT_SECRET}",
      "attributes": {}
    }
  ],
  "users": [
    {
      "username": "platformadmin",
      "email": "admin@minder.local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["platform:admin"]
    },
    {
      "username": "service-account-minder-backend",
      "enabled": true,
      "serviceAccountClientId": "minder-backend",
      "clientRoles": {
        "realm-management": ["manage-users", "manage-clients", "view-realm", "view-users", "query-users", "query-groups"]
      }
    },
    {
      "username": "service-account-minder-module",
      "enabled": true,
      "serviceAccountClientId": "minder-module",
      "realmRoles": ["module-register", "module-push"]
    }
  ]
}
